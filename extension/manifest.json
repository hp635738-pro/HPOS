{
  "manifest_version": 3,
  "name": "HPOS Browser Bridge",
  "version": "0.7.0",
  "description": "Local bridge between HPOS and an already-open DeepSeek chat tab. Relays PING and composer actions only — no cookies, passwords, or tokens.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "HPOS Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:4173/*",
        "http://127.0.0.1:4173/*"
      ],
      "js": ["protocol.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["protocol.js", "adapters/deepseek.config.js", "adapters/deepseek.identity.js", "adapters/reconcile.js", "adapters/deepseek.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["activeTab", "scripting"]
}
